# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID супергруппы с топиками (получить командой /id)
GROUP_ID=-1001234567890

# Топик, куда падают чеки
CHECKS_TOPIC_ID=0

# Топик Перчика для статистики
STATS_TOPIC_ID=0
SOCIAL_TOPICS = {CHECKS_TOPIC_ID}

# Топик для разовой заливки старых чеков (можно 0)
IMPORT_TOPIC_ID=0

TIMEZONE=Europe/Moscow
DB_PATH=perchik.db

# Автоотчёты: 1/0, день недели 0=пн..6=вс, часы
AUTO_REPORTS=1
REPORT_WEEKDAY=6
REPORT_HOUR=21
MONTH_REPORT_HOUR=12

AI_ENABLED=0
AI_PROVIDER=openai
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=25
